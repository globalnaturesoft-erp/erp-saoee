<% about_name = t('about_us') %>
<% title about_name %>
<% full_domain_path = request.env['rack.url_scheme'] + '://' + request.host_with_port %>

<% content_for :page_style do %>
    <link rel="stylesheet" href="/frontend/css/blog.css" />
<% end %>

<% content_for :metas do %>

    <!-- Facebook Open Graph -->
    <meta property="og:url" content="<%= request.url %>"/>
    <meta property="og:type" content="article" />
    <meta property="og:title" content="<%= about_name %>"/>
    <% if @meta_description.present? %>
    <meta property="og:description" content="<%= @meta_description %>"/>
    <% else %>
    <meta property="og:description" content="<%= about_name %>"/>
    <% end %>
    <meta property="og:site_name" content="SAO-EE.VN">
    <meta property="og:image" content="<%= full_domain_path %><%= @about.image %>" />
    <meta property="og:locale" content="<%= (I18n.locale == :vi) ? 'vi_VN' : 'en_US' %>">

    <!-- Google+ Open Graph -->
    <meta itemprop="name" content="<%= about_name %>">
    <% if @meta_description.present? %>
    <meta itemprop="description" content="<%= @meta_description %>">
    <% else %>
    <meta itemprop="description" content="<%= about_name %>">
    <% end %>
    <meta itemprop="image" content="<%= full_domain_path %><%= @about.image %>">

    <!-- Twitter Open Graph -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:site" content="@SAOEE">
    <meta name="twitter:title" content="<%= about_name %>">
    <% if @meta_description.present? %>
    <meta name="twitter:description" content="<%= @meta_description %>"/>
    <% else %>
    <meta name="twitter:description" content="<%= about_name %>"/>
    <% end %>
    <meta name="twitter:image" content="<%= full_domain_path %><%= @about.image %>">
<% end %>

<% content_for :page_style do %>
    <link rel="stylesheet" href="/frontend/css/service.css" />
<% end %>

<!-- PAGE HEADING -->
<section class="section__banner">
    <div class="banner__container container-fluid px-0">
        <div class="banner__image z-0">
            <img src="/frontend/images/559232c82f593cf41c58c9ef18708702.jpg" alt="">
        </div>
        <div class="banner__container container container--primary d-flex align-items-center">
            <h1 class="banner__title fw-bold text-white text-capitalize">
                <%= about_name %>
            </h1>
        </div>
    </div>
    <div class="banner__nav container-fluid">
        <div class="nav__container container container--primary d-flex align-items-center text-black-4 fs-6 h-100">
            <i class="fa-solid fa-house"></i>
            <i class="fa-solid fa-angle-right"></i>
            <span class="text-red fw-semibold text-uppercase"><%= about_name %></span>
        </div>
    </div>
</section>
<!-- END PAGE HEADING -->

<!-- STORY DETAIL-->
<section class="blog-detail glbg py-5">
    <div class="container blog-detail-content mb-5">
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 text-justify">
                <%= article_content(@about).html_safe %>
            </div>
        </div>
    </div>
    <div class="py-3 blbg">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <p class="fw-bold fs-12"><%= t('.tags') %></p>
                    <ul class="tags">
                        <% @about.get_tags.each_with_index do |tag,index| %>
                            <li><a href="#"><%= tag %></a></li>
                        <% end %>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END STORY DETAIL-->

<%= render 'erp/saoee/frontend/modules/contact_me' %>
