<% content_for :page_style do %>
    <link rel="stylesheet" href="/frontend/css/service.css" />
<% end %>

<%
    if I18n.locale == :en
        service_name = @service.en_name
        service_content = @service.en_content
        service_image = @service.en_image
    elsif I18n.locale == :ja
        service_name = @service.ja_name
        service_content = @service.ja_content
        service_image = @service.ja_image
    else
        service_name = @service.name
        service_content = @service.content
        service_image = @service.image
    end
%>

<% title service_name %>

<!-- PAGE HEADING -->
<section class="section__banner">
    <div class="banner__container container-fluid px-0">
        <div class="banner__image z-0">
            <%= (image_tag service_image.thumb_870_489, alt: service_name) if service_image.thumb_870_489.present? %>
        </div>
        <div class="banner__container container d-flex align-items-center">
            <h1 class="banner__title fw-bold text-white text-capitalize">
                <%= service_name %>
            </h1>
        </div>
    </div>
    <div class="banner__nav">
        <div class="nav__container container d-flex align-items-center text-black-4 fs-6 h-100">
            <%= link_to '<i class="fa-solid fa-house"></i>'.html_safe, erp_saoee.root_path, class: 'text-secondary' %>
            <i class="fa-solid fa-angle-right"></i>
            <%= link_to t('service'), erp_saoee.service_path, class: 'fw-semibold text-uppercase text-secondary' %>
            <i class="fa-solid fa-angle-right"></i>
            <span class="fw-semibold text-uppercase text-red"><%= service_name %></span>
        </div>
    </div>
</section>
<!-- END PAGE HEADING -->

<!-- service DETAIL -->
<section class="section__simulation glbgv2 sub2 py-5 py-sm-5 py-md-5 py-lg-mx">
    <div class="simulation__container container py-0 py-sm-0 py-md-0 py-lg-5">
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                <%= service_content.html_safe %>
            </div>
        </div>
    </div>
</section>
<!-- END service DETAIL -->

<%= render 'erp/saoee/frontend/modules/contact_me' %>
